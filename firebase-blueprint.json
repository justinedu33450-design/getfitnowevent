{
  "entities": {
    "Event": {
      "title": "Event",
      "description": "Un événement ou séance sportive créée par le coach.",
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Nom de la séance sportive."
        },
        "discipline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 50,
          "description": "Catégorie ou discipline sportive (prédéfinie ou personnalisée par le coach)."
        },
        "description": {
          "type": "string",
          "maxLength": 600,
          "description": "Détails du programme et matériel requis."
        },
        "location": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Lieu ou adresse précise de la séance."
        },
        "city": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Ville de l'événement pour la recherche par ville."
        },
        "region": {
          "type": "string",
          "maxLength": 80,
          "description": "Région de l'événement pour la recherche par région."
        },
        "hasCoords": {
          "type": "boolean",
          "description": "Indique si des coordonnées géographiques sont enregistrées."
        },
        "lat": {
          "type": "number",
          "description": "Latitude de l'événement (0 si non définie)."
        },
        "lng": {
          "type": "number",
          "description": "Longitude de l'événement (0 si non définie)."
        },
        "coachName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Nom du ou des coachs encadrant la séance."
        },
        "coachNames": {
          "type": "array",
          "description": "Liste des noms des coachs encadrant la séance (1 à 10)."
        },
        "coachUids": {
          "type": "array",
          "description": "Liste des UID des coachs administrateurs affectés à la séance (0 à 10)."
        },
        "startAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date et heure de début de la séance (Timestamp Firestore)."
        },
        "durationMinutes": {
          "type": "integer",
          "description": "Durée de la séance en minutes (15 à 240)."
        },
        "isUnlimitedCapacity": {
          "type": "boolean",
          "description": "Indique si la capacité de places est illimitée."
        },
        "maxCapacity": {
          "type": "integer",
          "description": "Nombre maximal de participants autorisés (0 si illimité, sinon 1 à 200)."
        },
        "registeredCount": {
          "type": "integer",
          "description": "Nombre actuel d'adhérents inscrits."
        },
        "lastRegId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant de la dernière inscription pour garantir l'atomicité."
        },
        "status": {
          "type": "string",
          "enum": ["published", "cancelled"],
          "description": "Statut de l'événement."
        },
        "cancelReason": {
          "type": "string",
          "enum": ["manual", "no_registrants", ""],
          "description": "Motif d'annulation (manuelle par le coach ou automatique à H-1 sans inscrit)."
        },
        "isPaid": {
          "type": "boolean",
          "description": "Indique si l'événement est payant."
        },
        "priceCents": {
          "type": "integer",
          "description": "Tarif de la séance en centimes d'euro (0 si gratuit, sinon 100 à 100000)."
        },
        "currency": {
          "type": "string",
          "enum": ["EUR"],
          "description": "Devise du tarif."
        },
        "paymentMode": {
          "type": "string",
          "enum": ["online", "onsite", "both"],
          "description": "Modes de règlement acceptés pour les événements payants."
        },
        "createdBy": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID du coach créateur."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de mise à jour."
        }
      },
      "required": [
        "title",
        "discipline",
        "description",
        "location",
        "city",
        "hasCoords",
        "lat",
        "lng",
        "coachName",
        "startAt",
        "durationMinutes",
        "isUnlimitedCapacity",
        "maxCapacity",
        "registeredCount",
        "lastRegId",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Registration": {
      "title": "Registration",
      "description": "Inscription gratuite d'un adhérent à un événement sportif.",
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant de l'événement réservé."
        },
        "eventTitle": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Titre de l'événement au moment de l'inscription."
        },
        "eventStartAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date de début de l'événement (Timestamp Firestore)."
        },
        "eventDurationMinutes": {
          "type": "integer",
          "description": "Durée prévue de la séance en minutes."
        },
        "eventEndAt": {
          "type": "string",
          "format": "date-time",
          "description": "Date et heure de fin de la séance (Timestamp Firestore)."
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Prénom de l'adhérent."
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Nom de famille de l'adhérent."
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Adresse email de l'adhérent."
        },
        "emailKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Empreinte normalisée de l'email pour éviter les doublons."
        },
        "attended": {
          "type": "boolean",
          "description": "Présence confirmée par le coach ou validée par l'adhérent après la séance."
        },
        "memberValidated": {
          "type": "boolean",
          "description": "Indique si l'adhérent a validé lui-même sa séance en fin de session."
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled"],
          "description": "Statut de l'inscription."
        },
        "amountCents": {
          "type": "integer",
          "description": "Montant facturé en centimes d'euro (0 si gratuit)."
        },
        "currency": {
          "type": "string",
          "enum": ["EUR"],
          "description": "Devise du paiement."
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["free", "paid", "pending", "refunded"],
          "description": "Statut du règlement de l'inscription."
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["free", "card", "onsite"],
          "description": "Mode de règlement choisi."
        },
        "paymentReference": {
          "type": "string",
          "maxLength": 64,
          "description": "Référence unique de transaction ou de réservation."
        },
        "cardBrand": {
          "type": "string",
          "maxLength": 24,
          "description": "Réseau de carte bancaire masqué (Visa, Mastercard, CB, Amex)."
        },
        "cardLast4": {
          "type": "string",
          "maxLength": 4,
          "description": "4 derniers chiffres de la carte (aucun numéro complet ou CVC stocké)."
        },
        "paidAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de confirmation du paiement."
        },
        "isGuest": {
          "type": "boolean",
          "description": "Indique si le participant est un invité inscrit par un autre adhérent."
        },
        "invitedByEmail": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Email normalisé de l'adhérent hôte ayant invité ce participant."
        },
        "invitedByEmailKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Empreinte normalisée de l'email de l'adhérent hôte."
        },
        "invitedByName": {
          "type": "string",
          "maxLength": 125,
          "description": "Nom complet de l'adhérent hôte ayant invité ce participant."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur d'inscription."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de mise à jour."
        }
      },
      "required": [
        "eventId",
        "eventTitle",
        "eventStartAt",
        "firstName",
        "lastName",
        "email",
        "emailKey",
        "attended",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "MemberProfile": {
      "title": "MemberProfile",
      "description": "Fiche de suivi adhérent gérée exclusivement par le coach.",
      "type": "object",
      "properties": {
        "emailKey": {
          "type": "string",
          "minLength": 8,
          "maxLength": 48,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Identifiant unique dérivé de l'email."
        },
        "email": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
          "description": "Email de l'adhérent."
        },
        "firstName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Prénom de l'adhérent."
        },
        "lastName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Nom de l'adhérent."
        },
        "phone": {
          "type": "string",
          "maxLength": 30,
          "description": "Téléphone optionnel."
        },
        "goal": {
          "type": "string",
          "maxLength": 120,
          "description": "Objectif sportif de l'adhérent."
        },
        "birthDate": {
          "type": "string",
          "maxLength": 10,
          "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$",
          "description": "Date de naissance de l'adhérent au format YYYY-MM-DD."
        },
        "fitnessLevel": {
          "type": "string",
          "enum": ["beginner", "intermediate", "advanced", ""],
          "description": "Niveau sportif de l'adhérent (débutant, intermédiaire, avancé)."
        },
        "notes": {
          "type": "string",
          "maxLength": 1000,
          "description": "Notes de suivi, blessures ou progression."
        },
        "followUpStatus": {
          "type": "string",
          "enum": ["active", "to_follow_up", "paused"],
          "description": "Statut de suivi du coach."
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 80000,
          "description": "Photo de profil de l'adhérent (JPEG compact encodé en base64 ou URL)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de création."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Horodatage serveur de mise à jour."
        }
      },
      "required": [
        "emailKey",
        "email",
        "firstName",
        "lastName",
        "phone",
        "goal",
        "notes",
        "followUpStatus",
        "createdAt",
        "updatedAt"
      ]
    },
